<?xml version="1.0" encoding="UTF-8"?>

<Logger version="2">
	<Path>/var/log/ovenmediaengine</Path>

	<!-- SRT schwatzt intern sehr viel; nur echte Fehler sind interessant. -->
	<Tag name="SRT" level="critical" />
	<Tag name="HTTP.Server" level="warn" />
	<Tag name=".*\.Stat" level="warn" />

	<!-- Zum Suchen eines Fehlers vorübergehend auf "debug" stellen. -->
	<Tag name=".*" level="info" />
</Logger>
