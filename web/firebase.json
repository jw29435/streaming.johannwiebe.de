{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/admin/regie", "destination": "/regie.html" },
      { "source": "/embed/**", "destination": "/ausgang.html" },
      { "source": "/**", "destination": "/ausgang.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      }
    ]
  }
}
